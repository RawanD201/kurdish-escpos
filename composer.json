{
    "name": "rawand201/kurdish-escpos",
    "description": "Print correctly shaped Kurdish (Sorani and Badini), Arabic and English receipts and labels on ESC/POS thermal printers and Zebra (ZPL) and TSC (TSPL) label printers. Pure PHP, no binaries.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "kurdish",
        "sorani",
        "badini",
        "arabic",
        "rtl",
        "bidi",
        "escpos",
        "esc-pos",
        "receipt",
        "thermal-printer",
        "zpl",
        "zebra",
        "tspl",
        "label-printer",
        "pos",
        "harfbuzz",
        "laravel"
    ],
    "homepage": "https://github.com/RawanD201/kurdish-escpos",
    "authors": [
        {
            "name": "RawanD201",
            "homepage": "https://github.com/RawanD201",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/RawanD201/kurdish-escpos/issues",
        "source": "https://github.com/RawanD201/kurdish-escpos",
        "security": "https://github.com/RawanD201/kurdish-escpos/security/policy"
    },
    "require": {
        "php": "^8.2",
        "ext-gd": "*",
        "ext-iconv": "*",
        "ext-json": "*",
        "bacon/bacon-qr-code": "^3.0"
    },
    "require-dev": {
        "laravel/pint": "^1.25",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "suggest": {
        "illuminate/support": "For the Laravel service provider and facade (^11.0|^12.0|^13.0)"
    },
    "autoload": {
        "psr-4": {
            "RawanD201\\KurdishEscpos\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RawanD201\\KurdishEscpos\\Tests\\": "tests/"
        }
    },
    "bin": [
        "bin/kurdish-escpos-check-font"
    ],
    "extra": {
        "laravel": {
            "providers": [
                "RawanD201\\KurdishEscpos\\Laravel\\KurdishEscposServiceProvider"
            ],
            "aliases": {
                "KurdishEscpos": "RawanD201\\KurdishEscpos\\Laravel\\Facades\\KurdishEscpos"
            }
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "analyse": "phpstan analyse --memory-limit=1G"
    },
    "scripts-descriptions": {
        "test": "Run the test suite",
        "format": "Fix the code style with Laravel Pint",
        "analyse": "Run PHPStan static analysis"
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
